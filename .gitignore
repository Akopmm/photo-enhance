service/__pycache__/
**/__pycache__/
*.pyc
.DS_Store
service/data/renders/
service/.venv/
service/data/
service/.env
experiments/.venv/
experiments/out/
experiments/

# SCUNet denoise weights (72MB) are fetched at image build time by the
# Dockerfile and checksum-verified there; they are not committed.
service/weights/scunet_color_real_psnr.pth
# FFDNet colour weights (3.4MB), fetched the same way.
service/weights/ffdnet_color.pth

# OpenVINO IRs, built inside the image (BiRefNet ~89MB, SCUNet ~35MB) and
# also produced locally by anyone who runs the conversion by hand. Build
# output, never source.
service/weights/*.xml
service/weights/*.bin

# Family photos and anything derived from them stay out of the repo -- this
# may become public, and the demo material should be the bird, not a child.
before-after/baby_*
experiments/out/denoise_*
experiments/out/cr3_vs_*
experiments/out/noisy_source.jpg
